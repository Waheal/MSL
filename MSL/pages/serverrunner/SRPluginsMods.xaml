<UserControl x:Class="MSL.pages.serverrunner.SRPluginsMods"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:MSL.controls"
             xmlns:langs="clr-namespace:MSL.langs"
             mc:Ignorable="d" Style="{StaticResource AnimationControl}"
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid>
        <TabControl x:Name="pluginsAndModsTab" Margin="5,10,10,10" Style="{StaticResource TabControlCapsuleInLine}" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="pluginsTabItem" Header="{Binding [SR_ManagePlugins], Source={x:Static langs:LanguageManager.Instance}}">
                <controls:MagicCard x:Name="ManagePluginsCard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ContextMenu x:Key="PluginListContextMenu">
                                        <MenuItem x:Name="disPlugin" Click="disPlugin_Click" Header="{Binding [SR_TogglePlugin], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="FileCancel"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="delPlugin" Click="delPlugin_Click" Header="{Binding [SR_DeletePlugin], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="FileRemove"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="disAllPlugin" Click="disAllPlugin_Click" Header="{Binding [SR_ToggleAllPlugins], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="Cancel"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="openpluginsDir" Click="openpluginsDir_Click" Header="{Binding [SR_OpenPluginDir], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="Folder"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding [SR_PluginList], Source={x:Static langs:LanguageManager.Instance}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding [SR_PluginRestartHint], Source={x:Static langs:LanguageManager.Instance}}" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </hc:UniformSpacingPanel>

                            <ListView x:Name="pluginslist"
                                      Grid.Row="2"
                                      hc:Empty.ShowEmpty="true"
                                      SelectionMode="Extended"
                                      BorderThickness="0"
                                      FontSize="14"
                                      Background="{DynamicResource ContentRegionBrush}"
                                      ContextMenu="{StaticResource PluginListContextMenu}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="32">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected, Mode=TwoWay}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="pluginlistPluginName" Width="350" Header="{Binding [SR_PluginName], Source={x:Static langs:LanguageManager.Instance}}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                                        <iconPacks:PackIconMaterial Kind="FileDocument"/>

                                                        <Border CornerRadius="4" Background="#FF5252" Margin="0,0,5,0" Padding="4,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding [SR_Disabled], Source={x:Static langs:LanguageManager.Instance}}" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Width="Auto" Text="{Binding PluginName}" FontSize="12"/>
                                                    </hc:UniformSpacingPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button hc:IconElement.Width="14"
                                                            hc:Poptip.Content="{Binding [SR_ShowActions], Source={x:Static langs:LanguageManager.Instance}}"
                                                            hc:Poptip.HorizontalOffset="40"
                                                            hc:Poptip.Placement="Left"
                                                            Click="MenuButton_Click"
                                                            ContextMenu="{StaticResource PluginListContextMenu}">
                                                        <Button.Content>
                                                            <iconPacks:PackIconMaterial Kind="DotsHorizontal"/>
                                                        </Button.Content>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                        <hc:UniformSpacingPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Vertical" Spacing="10">
                            <hc:UniformSpacingPanel.Resources>
                                <!-- 普通按钮样式 -->
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Height" Value="54"/>
                                </Style>

                                <!-- Primary按钮样式 -->
                                <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Height" Value="54"/>
                                </Style>

                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </hc:UniformSpacingPanel.Resources>

                            <TextBlock Text="{Binding [SR_Actions], Source={x:Static langs:LanguageManager.Instance}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Button x:Name="reFresh_Copy" Style="{StaticResource PrimaryButtonStyle}" Click="reFresh_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Refresh"/>
                                        <TextBlock Text="{Binding [SR_Refresh], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button x:Name="addPluginBtn" Click="addPlugin_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Plus"/>
                                        <TextBlock Text="{Binding [SR_AddPlugin], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button x:Name="DownloadPluginBtn" Click="DownloadPluginBtn_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Download"/>
                                        <TextBlock Text="{Binding [SR_DownloadPlugin], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button Click="openpluginsDir_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Folder"/>
                                        <TextBlock Text="{Binding [SR_OpenFolder], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                        </hc:UniformSpacingPanel>
                    </Grid>
                </controls:MagicCard>
            </TabItem>
            <TabItem x:Name="modsTabItem" Header="{Binding [SR_ManageMods], Source={x:Static langs:LanguageManager.Instance}}">
                <controls:MagicCard x:Name="ManageModsCard">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ContextMenu x:Key="PluginListContextMenu">
                                        <MenuItem x:Name="disMod" Click="disMod_Click" Header="{Binding [SR_ToggleMod], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="FileCancel"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="delMod" Click="delMod_Click" Header="{Binding [SR_DeleteMod], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="FileRemove"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="disAllMod" Click="disAllMod_Click" Header="{Binding [SR_ToggleAllMods], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="Cancel"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="openmodsDir" Click="openmodsDir_Click" Header="{Binding [SR_OpenModDir], Source={x:Static langs:LanguageManager.Instance}}">
                                            <MenuItem.Icon>
                                                <iconPacks:PackIconMaterial Kind="Folder"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding [SR_ModList], Source={x:Static langs:LanguageManager.Instance}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding [SR_ModRestartHint], Source={x:Static langs:LanguageManager.Instance}}" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </hc:UniformSpacingPanel>

                            <ListView x:Name="modslist"
                                      Grid.Row="2"
                                      FontSize="14"
                                      hc:Empty.ShowEmpty="true"
                                      SelectionMode="Extended"
                                      BorderThickness="0"
                                      Background="{DynamicResource ContentRegionBrush}"
                                      ContextMenu="{StaticResource PluginListContextMenu}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="32">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected, Mode=TwoWay}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="modlistModName" Width="350" Header="{Binding [SR_ModName], Source={x:Static langs:LanguageManager.Instance}}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                                        <iconPacks:PackIconMaterial Kind="FileDocument"/>

                                                        <Border CornerRadius="4" Background="#FF5252" Margin="0,0,5,0" Padding="4,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding [SR_Disabled], Source={x:Static langs:LanguageManager.Instance}}" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <Border CornerRadius="4" Background="Orange" Margin="0,0,5,0" Padding="4,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsClient}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding [SR_ClientSide], Source={x:Static langs:LanguageManager.Instance}}" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <TextBlock Width="Auto" Text="{Binding ModName}" FontSize="12"/>
                                                    </hc:UniformSpacingPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button hc:IconElement.Width="14"
                                                            hc:Poptip.Content="{Binding [SR_ShowActions], Source={x:Static langs:LanguageManager.Instance}}"
                                                            hc:Poptip.HorizontalOffset="40"
                                                            hc:Poptip.Placement="Left"
                                                            Click="MenuButton_Click"
                                                            Visibility="Collapsed"
                                                            ContextMenu="{StaticResource PluginListContextMenu}">
                                                        <Button.Content>
                                                            <iconPacks:PackIconMaterial Kind="DotsHorizontal"/>
                                                        </Button.Content>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                        <hc:UniformSpacingPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Vertical" Spacing="10">
                            <hc:UniformSpacingPanel.Resources>
                                <!-- 普通按钮样式 -->
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Height" Value="48"/>
                                </Style>

                                <!-- Primary按钮样式 -->
                                <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Height" Value="48"/>
                                </Style>

                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="14"/>
                                </Style>
                            </hc:UniformSpacingPanel.Resources>

                            <TextBlock Text="{Binding [SR_Actions], Source={x:Static langs:LanguageManager.Instance}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="reFresh_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Refresh"/>
                                        <TextBlock Text="{Binding [SR_Refresh], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button x:Name="addModsTip" Style="{StaticResource PrimaryButtonStyle}" Click="addModsTip_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Lightbulb"/>
                                        <TextBlock Text="{Binding [SR_AddModNote], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button Click="detectClientMods_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="MagnifyScan"/>
                                        <TextBlock Text="{Binding [SR_DetectClientMods], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button x:Name="addModBtn" Click="addMod_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Plus"/>
                                        <TextBlock Text="{Binding [SR_AddMod], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button x:Name="DownloadModBtn" Click="DownloadModBtn_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Download"/>
                                        <TextBlock Text="{Binding [SR_DownloadMod], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                            <Button Click="openmodsDir_Click">
                                <Button.Content>
                                    <hc:UniformSpacingPanel Orientation="Horizontal" Spacing="5">
                                        <iconPacks:PackIconMaterial Kind="Folder"/>
                                        <TextBlock Text="{Binding [SR_OpenFolder], Source={x:Static langs:LanguageManager.Instance}}"/>
                                    </hc:UniformSpacingPanel>
                                </Button.Content>
                            </Button>
                        </hc:UniformSpacingPanel>
                    </Grid>
                </controls:MagicCard>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
